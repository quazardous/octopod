              "summary": {
                "type": "string",
                "maxLength": 200
              },
              "input": {
                "default": false,
                "type": "boolean"
              },
              "tty": {
                "default": false,
                "type": "boolean"
              },
              "confirm": {
                "type": "string",
                "maxLength": 200
              }
            },
            "required": [
              "command"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
