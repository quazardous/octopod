{
  "$id": "https://raw.githubusercontent.com/quazardous/octopod/main/schema/octopod.schema.json",
  "title": "octopod.yaml: a project's declaration",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "project": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "compose": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "env_file": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "expose": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "host": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "service"
        ],
        "additionalProperties": false
      }
    },
    "services": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "recipe": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "programs": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "command": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000,
                  "pattern": "^[^\\r\\n]*$"
                },
                "autostart": {
                  "default": true,
                  "type": "boolean"
                }
              },
              "required": [
                "command"
              ],
              "additionalProperties": false
            }
          },
          "supervisor_d": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "actions": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "command": {
                  "minItems": 1,
                  "maxItems": 64,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 4000
                  }
                },
                "summary": {
                  "type": "string",
                  "maxLength": 200
                },
                "input": {
                  "default": false,
                  "type": "boolean"
                },
                "tty": {
                  "default": false,
                  "type": "boolean"
                },
                "confirm": {
                  "type": "string",
                  "maxLength": 200
                }
              },
              "required": [
                "command"
              ],
              "additionalProperties": false
            }
          },
          "home": {
            "anyOf": [
              {
                "type": "boolean",
                "const": true
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              }
            ]
          },
          "route": {
            "type": "boolean",
            "const": false
          },
          "shared": {
            "type": "boolean"
          },
          "workdir": {
            "type": "string",
            "pattern": "^\\/[A-Za-z0-9._-][A-Za-z0-9._/-]*$"
          },
          "link": {
            "type": "string",
            "maxLength": 400,
            "pattern": "^(\\/[A-Za-z0-9._~\\/?=&%#-]*|https?:\\/\\/[^\\s\"'<>]+)$"
          },
          "caches": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,30}$"
            },
            "additionalProperties": {
              "type": "string",
              "pattern": "^\\/[A-Za-z0-9._/-]*$"
            }
          },
          "temp": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,30}$"
            },
            "additionalProperties": {
              "type": "string",
              "pattern": "^\\/[A-Za-z0-9._/-]*$"
            }
          },
          "reach": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
            },
            "additionalProperties": {
              "minItems": 1,
              "maxItems": 16,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
              }
            }
          }
        },
        "required": [
          "recipe"
        ],
        "additionalProperties": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 200
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "maxItems": 128,
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 64
              }
            }
          ]
        }
      }
    },
    "recipes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 400
      }
    },
    "workspace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "shared": {
      "anyOf": [
        {
          "type": "boolean",
          "const": true
        },
        {
          "maxItems": 32,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          }
        }
      ]
    },
    "group": {
      "type": "string",
      "maxLength": 57,
      "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "tags": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
      }
    },
    "variants": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,30}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "summary": {
            "type": "string",
            "maxLength": 200
          },
          "workspace": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "compose": {
            "maxItems": 16,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "services": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "on-switch": {
            "maxItems": 16,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*\\/[a-z][a-z0-9_-]*$"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
