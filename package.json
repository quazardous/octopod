{
  "name": "@quazardous/octopod",
  "version": "0.6.0",
  "description": "One local edge for all your Docker projects: a shared Traefik, declared projects and isolated networks, behind a small API",
  "license": "MIT",
  "author": "David Berlioz",
  "type": "module",
  "bin": {
    "octopod": "bin/octopod.js"
  },
  "files": [
    "bin",
    "dist",
    "!dist/**/*.test.*",
    "recipes",
    "schema",
    "assets/*.ico",
    "assets/*.svg",
    "assets/*.png",
    "assets/README.md",
    "console",
    "gnome",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:leaks": "scripts/check-leaks.sh",
    "oidc:recipe": "node scripts/oidc-dockerfile.mjs",
    "schemas": "tsx scripts/schemas.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "tsx": "^4.23.15",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quazardous/octopod.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
